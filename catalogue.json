{
  "schemaVersion": 1,
  "name": "Orbit Play",
  "description": "A Remote Play app for jailbroken PS5s, available on Mac, Windows and Linux. Enable Remote Play for local PS5 accounts and stream over your local network without PSN sign-in or an internet connection, or away from home over the internet once it is set up at home or with a code from the PS5. Download just the desktop app: the PS5 helper is built in, and the app sends it to the PS5 and starts it through Payload Manager or an ELF loader.",
  "version": "0.6.0",
  "repository": "https://github.com/saawant12/orbit-play-ps5",
  "status": "beta",
  "publicReleaseAvailable": true,
  "hardwareVerified": false,
  "macSigning": "ad-hoc",
  "notarized": false,
  "testTarget": {
    "mac": {
      "architecture": "arm64",
      "minimumOS": "macOS 26"
    },
    "windows": {
      "architecture": "x64",
      "minimumOS": "Windows 10",
      "armCompatibility": {
        "architecture": "arm64",
        "minimumOS": "Windows 11",
        "execution": "x64 emulation using the same Windows x64 download",
        "tested": true
      }
    },
    "linux": {
      "architectures": [
        "x64",
        "arm64"
      ],
      "baseline": "Ubuntu 24.04"
    },
    "ps5": {
      "firmware": "13.60",
      "jailbreak": "Relapse",
      "loader": "Payload Manager v0.5.2 and v0.6.3"
    },
    "network": "same trusted LAN at home; away from home, both online through Orbit Link",
    "consoleState": "awake, logged into the intended user"
  },
  "components": [
    {
      "id": "app",
      "name": "Orbit Play computer app",
      "license": "AGPL-3.0-only",
      "artifactPattern": "OrbitPlay-{version}-macos-arm64.dmg",
      "artifactPatterns": {
        "macos-arm64": "OrbitPlay-{version}-macos-arm64.dmg",
        "windows-x64": "OrbitPlay-{version}-windows-x64.zip",
        "linux-x64": "OrbitPlay-{version}-linux-x64.AppImage",
        "linux-arm64": "OrbitPlay-{version}-linux-arm64.AppImage"
      },
      "includes": [
        "Chiaki player",
        "matching PS5 helper",
        "Orbit Link node for playing away from home"
      ],
      "documentation": "README.md"
    },
    {
      "id": "ps5",
      "name": "Orbit Play PS5 helper",
      "license": "GPL-3.0-or-later",
      "artifactPattern": "orbit-play-{version}-ps5.elf",
      "documentation": "README.md",
      "includedInDesktopApp": true,
      "standaloneDownloadOptional": true
    }
  ],
  "sourceCode": "Each release includes orbit-play-{version}-source.tar.gz with the complete source of both components and Orbit Link, and orbit-play-{version}-third-party-source.tar with the source of the GPL, LGPL and AGPL libraries the apps ship",
  "features": [
    "Remote Play for jailbroken PS5s from a computer app for Mac, Windows and Linux",
    "Enable Remote Play for local PS5 accounts, creating a local account ID after confirmation when needed",
    "Included streaming player and matching PS5 helper",
    "Starts its PS5 helper through Payload Manager or an ELF loader; no separate ELF download needed",
    "Replace helper on PS5: stops a different helper version, never during a stream, and starts the included one; helpers before 0.6.0 are stopped through Payload Manager",
    "Local trust-code pairing without PSN sign-in in Orbit Play",
    "Automatic account-ID and Remote Play PIN exchange; no manual lookup, conversion or separate PIN tool",
    "Separate pairing per console address and active user",
    "360p, 540p, 720p or 1080p H.264 or HEVC; 30/60 fps; 1–50 Mbps",
    "Hardware video decoding: VideoToolbox (macOS), D3D11VA (Windows), Vulkan (Linux), with processor fallback",
    "DualSense rumble, adaptive triggers, haptics over USB and touchpad swipes",
    "DualSense sticks and motion sent to the PS5; a controller can connect before or during the stream",
    "Computer microphone, muted at the start of every stream",
    "Custom keyboard and mouse controls with optional mouse aiming on the right stick",
    "Type the text the PS5 asks for, such as a search, with the computer's keyboard",
    "Full-screen player (F11, or Ctrl+Cmd+F on a Mac); the computer and its screen stay awake while the player is open",
    "Picture fit, fill or stretch for windows and screens of another shape (B in the player)",
    "PS5 sound on or off on the computer during the stream (N in the player)",
    "The stream keeps going while someone else plays on the PS5 with their own profile, as long as the streaming profile stays logged in",
    "Asks for a PS5 login passcode when the profile has one; kept only until the app quits",
    "Play away from home through Orbit Link: direct, end-to-end encrypted connection between the computer and the PS5, with no account or open port; Orbit Play's server only introduces the devices",
    "Set up from anywhere with a one-time away code and the trust code from the PS5",
    "Stream statistics with frame rate, packet loss, codec and decoder",
    "Up to three reconnect attempts after network interruptions",
    "Account-settings recovery with review before confirmation",
    "Diagnostics that omit connection secrets",
    "Optional daily update check against GitHub releases; sends no console or account data",
    "Updates itself from 0.6.0 on: Update now downloads the new version, checks it against the release's checksums, installs it and restarts"
  ],
  "limitations": [
    "At home the computer and awake PS5 must be on the same trusted network; away from home, both need the internet and the PS5 must stay on with the helper running",
    "A jailbroken PS5 and payload loader are required to run the helper",
    "Tested on PS5 firmware 13.60 only; other firmware is untested and needs a restart after account setup before pairing",
    "Account setup is experimental; new-profile setup and recovery have been tested on 13.60",
    "Account-settings backups do not contain games or saves",
    "We recommend a separate new PS5 profile with no saves for account setup",
    "Existing account IDs are kept; creating a new ID requires accepting the risk to existing saves",
    "No wake from Rest Mode, HDR or account migration in this beta",
    "Orbit Play's server relays no traffic, so networks that block direct connections can't play away from home; away from home has been tested with an Apple Silicon Mac only",
    "DualSense haptics need a USB cable; on a Mac its audio device must be set to 4 channels. Over Bluetooth haptics play as rumble",
    "Intel Macs and macOS versions before 26 are not supported",
    "Mac builds are not notarized and Windows builds are not code-signed; first launch may need manual approval"
  ],
  "inDevelopment": [
    "Wake the PS5 from Rest Mode",
    "HDR"
  ],
  "documentation": {
    "readme": "README.md",
    "agents": "llms.txt",
    "accountSetup": "guides/account-setup.md",
    "gettingStarted": "guides/getting-started.md",
    "installation": "guides/installation.md",
    "ps5Helper": "guides/ps5-helper.md",
    "playAwayFromHome": "guides/play-away-from-home.md",
    "playbackAndControls": "guides/playback-and-controls.md",
    "troubleshooting": "guides/troubleshooting.md",
    "screenshots": "assets/screenshots/0.5.5/README.md",
    "releaseNotes": "release-notes/0.6.0.md"
  },
  "payloadFeed": "payloads.json",
